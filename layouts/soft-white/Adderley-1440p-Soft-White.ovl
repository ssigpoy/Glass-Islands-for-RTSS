[Source53]
Name=LagRtssBase
Units=
Format=
Formula=swavg("Frametime",240)
Provider=HAL
ID=Stub
[Source54]
Name=LagRtssWindow
Units=
Format=
Formula=validate(LagRtssBase) ? min(512,max(6,int(1400/max(1,LagRtssBase)))) : 6
Provider=HAL
ID=Stub
[Source55]
Name=LagRtssPeak
Units=
Format=
Formula=swmax("Frametime",LagRtssWindow)
Provider=HAL
ID=Stub
[Source56]
Name=LagRtssHit
Units=
Format=
Formula=(validate(buf("Frametime",-8)) && validate(LagRtssPeak) && validate(LagRtssBase)) ? ((LagRtssBase > 0) && (LagRtssPeak >= max(LagRtssBase*1.75,LagRtssBase+8.0))) : 0
Provider=HAL
ID=Stub
[Source57]
Name=BnNativeMean
Units=
Format=
Formula=swavg("Frametime",120)
Provider=HAL
ID=Stub
[Source58]
Name=BnNativeCount
Units=
Format=
Formula=validate(BnNativeMean) ? min(512,max(8,int(1000/max(1,BnNativeMean)))) : 8
Provider=HAL
ID=Stub
[Source59]
Name=BnNativeCurrent
Units=
Format=
Formula=swavg("Frametime",BnNativeCount)
Provider=HAL
ID=Stub
[Source60]
Name=BnFps
Units=
Format=
Formula=(validate("Frametime") && validate(buf("Frametime",-8)) && validate(BnNativeCurrent)) ? ((BnNativeCurrent > 0) ? 1000.0/BnNativeCurrent : 1/0) : 1/0
Provider=HAL
ID=Stub
[Source61]
Name=BnSessionAge
Units=
Format=
Formula=validate(BnFps) ? (validate(buf(x,-1)) ? min(15,buf(x,-1)+1) : 1) : 0
Provider=HAL
ID=Stub
[Source62]
Name=BnReference
Units=
Format=
Formula=swmax(BnFps,max(1,BnSessionAge))
Provider=HAL
ID=Stub
[Source63]
Name=BnSlow
Units=
Format=
Formula=((BnSessionAge >= 4) && validate(BnReference) && validate(BnFps)) ? (BnFps <= BnReference*0.92) : 0
Provider=HAL
ID=Stub
[Source64]
Name=BnFpsActive
Units=
Format=
Formula=validate(BnFps) ? (BnFps > 0) : (validate("Framerate") ? ("Framerate" > 0) : 0)
Provider=HAL
ID=Stub
[Source65]
Name=BnCandidate
Units=
Format=
Formula=(BnFpsActive && validate("GPU1 usage")) ? (("GPU1 usage" >= 92) ? 6 : (validate(CpuPeakLoad) ? (((("GPU1 usage" <= 85) && (CpuPeakLoad >= 90) && BnSlow) || (("GPU1 usage" <= 80) && (CpuPeakLoad >= 98))) ? 5 : 0) : 0)) : 0
Provider=HAL
ID=Stub
[Source66]
Name=BnReason
Units=
Format=
Formula=((BnCandidate > 0) && validate(buf(BnCandidate,-2)) && validate(buf(BnCandidate,-3)) && validate(buf(BnCandidate,-4)) && validate(buf(BnCandidate,-5))) ? (((BnCandidate == buf(BnCandidate,-2)) && (BnCandidate == buf(BnCandidate,-3)) && (BnCandidate == buf(BnCandidate,-4)) && (BnCandidate == buf(BnCandidate,-5))) ? BnCandidate : 0) : 0
Provider=HAL
ID=Stub
[Source67]
Name=ShortCpuHint
Units=
Format=
Formula=(validate(CpuPeakLoad) && validate("GPU1 usage") && validate(buf(CpuPeakLoad,-2)) && validate(buf("GPU1 usage",-2))) ? ((CpuPeakLoad >= 95) && (CpuPeakLoad >= buf(CpuPeakLoad,-2)+15) && ("GPU1 usage" <= 85)) : 0
Provider=HAL
ID=Stub
[Source68]
Name=ShortGpuHint
Units=
Format=
Formula=(validate(CpuPeakLoad) && validate("GPU1 usage") && validate(buf(CpuPeakLoad,-2)) && validate(buf("GPU1 usage",-2))) ? (("GPU1 usage" >= 95) && ("GPU1 usage" >= buf("GPU1 usage",-2)+12) && ((CpuPeakLoad < 90) || (CpuPeakLoad < buf(CpuPeakLoad,-2)+8))) : 0
Provider=HAL
ID=Stub
[Source69]
Name=LagSensorReason
Units=
Format=
Formula=LagRtssHit ? (ShortCpuHint ? 1 : (ShortGpuHint ? 2 : 4)) : 0
Provider=HAL
ID=Stub
[Source70]
Name=LagPulseCPU
Units=
Format=
Formula=(LagSensorReason == 1) && (validate(swmax(x,11)) ? (swmax(x,11) == 0) : 1)
Provider=HAL
ID=Stub
[Source71]
Name=LagPulseGPU
Units=
Format=
Formula=(LagSensorReason == 2) && (validate(swmax(x,11)) ? (swmax(x,11) == 0) : 1)
Provider=HAL
ID=Stub
[Source72]
Name=LagPulseSPIKE
Units=
Format=
Formula=(LagSensorReason == 4) && (validate(swmax(x,11)) ? (swmax(x,11) == 0) : 1)
Provider=HAL
ID=Stub
[Source73]
Name=LagNewShortPulse
Units=
Format=
Formula=LagPulseCPU+2*LagPulseGPU+4*LagPulseSPIKE
Provider=HAL
ID=Stub
[Source74]
Name=LagShortShown
Units=
Format=
Formula=(LagNewShortPulse > 0) ? LagNewShortPulse : (validate(buf(LagNewShortPulse,-2)) ? buf(LagNewShortPulse,-2) : 0)
Provider=HAL
ID=Stub
[Source75]
Name=BnCpuState
Units=
Format=
Formula=validate(buf(x,-1)) ? ((buf(x,-1) > 0) ? (((BnReason == 5) && (buf(x,-1) > 1)) ? (buf(x,-1)-1) : -10) : ((buf(x,-1) < -1) ? (buf(x,-1)+1) : (((BnReason == 5) && (LagShortShown == 0)) ? 15 : 0))) : (((BnReason == 5) && (LagShortShown == 0)) ? 15 : 0)
Provider=HAL
ID=Stub
[Source76]
Name=BnGpuState
Units=
Format=
Formula=validate(buf(x,-1)) ? ((buf(x,-1) > 0) ? (((BnReason >= 6) && (buf(x,-1) > 1)) ? (buf(x,-1)-1) : -10) : ((buf(x,-1) < -1) ? (buf(x,-1)+1) : (((BnReason >= 6) && (LagShortShown == 0)) ? 15 : 0))) : (((BnReason >= 6) && (LagShortShown == 0)) ? 15 : 0)
Provider=HAL
ID=Stub
[Source77]
Name=LagShownReason
Units=
Format=
Formula=(LagShortShown > 0) ? LagShortShown : ((BnCpuState > 0) ? 5 : ((BnGpuState > 0) ? BnReason : 0))
Provider=HAL
ID=Stub
[Source78]
Name=LagRedVisible
Units=
Format=
Formula=validate(LagShownReason) ? ((LagShownReason > 0) && (LagShownReason <= 4)) : 0
